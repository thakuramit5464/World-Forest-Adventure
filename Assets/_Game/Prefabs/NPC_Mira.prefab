  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 659697901523167563}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e206e65ff0efd054d87db3a7b8a77fd0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Greenhaven::Greenhaven.Quests.QuestGiver
  manager: {fileID: 0}
  quest: {fileID: 11400000, guid: 772fddb8a45cc924798496c0f2d1add1, type: 2}
  npcId: mira
  offerLines:
  - Oh! A new face in Greenhaven. Welcome, traveller!
  - 'Could you help me? Three supply crates fell off my cart on the trail north: one just past the bridge, the others in the Whispering Forest beyond the gate.'
  - Bring them back and I'll bake you something special!
  activeLines:
  - Any luck with the crates? Follow the road north over the bridge, then through the forest gate.
  completeLines:
  - You found all three! Greenhaven owes you one, explorer.
  - Here, still-warm honey bread. Oh, and Elder Rowan was asking for you. He's on the bench by his house.
  doneLines:
  - Thanks again for the supplies! The whole village eats well tonight.
