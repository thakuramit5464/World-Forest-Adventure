  m_Name: 
  m_EditorClassIdentifier: Greenhaven::Greenhaven.Interaction.DialogueInteractable
  speakerName: Summit Shrine
  promptVerb: Inspect
  lines:
  - "Cloudpeak Summit \u2014 you made it! The whole Whispering Forest lies below, and Greenhaven beyond the trees."
  - 'Three cairns stand around the summit: one toward the forest, one at the far edge, and one by the ruined arch.'
  - 'Worn letters are carved into the stone: "Light the forest first, then the edge, and last the arch."'
